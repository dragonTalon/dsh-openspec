{
  // Standalone (extracted from the DSH monorepo). Resolves `@deepseek-ai/*`
  // types from node_modules instead of project references, and emits to
  // lib/types for tsdown to bundle into lib/index.js + lib/invariant.js.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "include": ["src"]
}
